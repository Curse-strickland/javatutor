<?xml version="1.0" encoding="UTF-8"?>
<!--
  JavaTutor 后端日志配置（三层日志里的第 1、2 层）：
    - console        ：可读格式，systemd journal 兜底
    - logs/app.log    ：应用日志（结构化 JSON，含 requestId）
    - logs/request.log：请求访问日志（RequestLoggingFilter 输出单行 JSON，原样落盘）
  日志目录由 application.properties 的 javatutor.logging.dir 决定（默认 ./logs），
  生产通过环境变量 JAVATUTOR_LOG_DIR 注入（见 .github/workflows/deploy.yml）。
-->
<configuration>
    <springProperty scope="context" name="LOG_DIR" source="javatutor.logging.dir" defaultValue="logs"/>

    <!-- ── 控制台（可读） ── -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} [%X{requestId:-}] - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ── 应用日志（结构化 JSON） ── -->
    <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/app.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdc>true</includeMdc>
        </encoder>
    </appender>

    <!-- ── 请求访问日志（单行 JSON） ── -->
    <appender name="REQUEST_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/request.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/request.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

    <!-- REQUEST logger 只写 request.log，不回灌 app.log / console -->
    <logger name="REQUEST" level="INFO" additivity="false">
        <appender-ref ref="REQUEST_FILE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
